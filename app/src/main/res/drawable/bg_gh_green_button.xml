<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gh_green_hover" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#3FB950" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gh_green_primary" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#2EA043" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
