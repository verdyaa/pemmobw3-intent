<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#30363D" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#8B949E" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/gh_badge_bg" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/gh_border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
